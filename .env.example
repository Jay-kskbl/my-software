# 复制为项目根目录下的 .env 后按本机情况修改。本文件只放示例值，不要写真实密码。
# 后端和 deploy/docker-compose.yml 都读取根目录的 .env。

# ---- docker-compose 用（PostgreSQL 容器初始化）----
POSTGRES_USER=docmgr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docmgr
POSTGRES_PORT=5432
OPENSEARCH_PORT=9200
# OpenSearch 的 JVM 堆大小；T00 环境实测后按本机内存调整
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ---- 后端必填 ----
# PostgreSQL 连接串，账号密码需与上面一致
DATABASE_URL=postgresql://docmgr:change-me@localhost:5432/docmgr
# OpenSearch 地址（开发环境关闭了安全插件，使用 http）
OPENSEARCH_URL=http://localhost:9200
# CLIP 模型服务地址（services/clip_service；未启动时 /health 会如实报告不可用）。
# 端口要与下面“CLIP 模型服务”一节的 CLIP_PORT 一致
CLIP_SERVICE_URL=http://localhost:8001
# embed 任务调用 CLIP 服务编码一张图片的超时（秒）；可选，默认 60
CLIP_ENCODE_TIMEOUT_SECONDS=60

# 签发登录令牌（JWT）的密钥，至少 32 个字符。下面是示例值，必须换成自己生成的：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 修改后所有已签发的令牌立即失效（用户需要重新登录）
JWT_SECRET=change-me-generate-a-random-secret-of-32-chars-or-more

# ---- 后端可选 ----
# /health 检查每个依赖服务的超时（秒）
HEALTH_CHECK_TIMEOUT_SECONDS=2
# API 与命令行工具连接数据库最多等多久（秒，整数 2–300）：数据库停掉时接口在这个时间内返回 503
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# 登录令牌有效期（秒）
ACCESS_TOKEN_EXPIRE_SECONDS=3600
# 上传文件的存储根目录。相对路径相对项目根目录；默认 storage（已在 .gitignore 中）
STORAGE_ROOT=storage

# ---- 上传限制（可选，以下为默认值）----
# 单个文件大小上限（字节）；默认 50 MB
UPLOAD_MAX_BYTES=52428800
# 文件名长度上限（字符数，最大 255）
UPLOAD_MAX_FILENAME_CHARS=255
# 允许上传的类型（按文件内容识别，与扩展名无关）；可选值：pdf、docx、xlsx、png、jpg
UPLOAD_ALLOWED_TYPES=pdf,docx,xlsx,png,jpg

# ---- OpenSearch（可选，以下为默认值）----
# 调用 OpenSearch 的超时（秒）
OPENSEARCH_TIMEOUT_SECONDS=10
# 加在索引名（doc_meta、chunks）前面的前缀，只能是小写字母、数字、_、-；默认为空
OPENSEARCH_INDEX_PREFIX=

# 只给测试用：指向一个装了 analysis-smartcn 插件的 OpenSearch。
# 设置后 backend/tests/opensearch/ 下的测试才会运行；它们使用独立的索引名前缀，结束时自行清理
# TEST_OPENSEARCH_URL=http://localhost:9200

# ---- OCR Worker（ocr 环境，可选，以下为默认值）----
# 数据库、OpenSearch、存储目录与后端共用上面的 DATABASE_URL、OPENSEARCH_*、STORAGE_ROOT
# 模型目录：模型文件需手动放置，目录缺失时启动报错退出，不会自动下载。相对路径相对项目根目录
OCR_DET_MODEL_DIR=models/ocr/PP-OCRv5_mobile_det
OCR_REC_MODEL_DIR=models/ocr/PP-OCRv5_mobile_rec
OCR_DEVICE=cpu
# PDF 页渲染成图片的分辨率（72–600）
OCR_PDF_DPI=200
# 置信度低于它的文字行不写进检索片段（识别结果照样全部保存）；0 表示全部保留
OCR_MIN_CONFIDENCE=0
# 送去识别的图片像素数上限（渲染后的 PDF 页同样受限）
OCR_MAX_PIXELS=100000000
# 租约时长（秒）与续租间隔（秒）：续租间隔不能超过租约的一半
OCR_WORKER_LEASE_SECONDS=60
OCR_WORKER_HEARTBEAT_SECONDS=15
# 队列为空时隔多久再查一次（秒）
OCR_WORKER_POLL_SECONDS=2
# 一页（或一张图片）的识别时间上限（秒），超过就杀掉识别子进程
OCR_WORKER_TASK_TIMEOUT_SECONDS=300
# 加载模型的时间上限（秒）
OCR_WORKER_LOAD_TIMEOUT_SECONDS=180
# 识别子进程的内存上限（MB），只在 Linux 上有效
OCR_WORKER_MEMORY_LIMIT_MB=3072
# 处理多少个任务后主动退出，由外层循环重新拉起
OCR_WORKER_MAX_TASKS=200
# 连接数据库最多等多久（秒，整数 2–300）：主机不可达时启动检查在这个时间内报错
OCR_WORKER_DB_CONNECT_TIMEOUT_SECONDS=10

# ---- 检索（可选，以下为默认值；都是实验参数，随检索日志记录）----
SEARCH_DEFAULT_TOP_K=20
# 不能超过 SEARCH_CHANNEL_DEPTH
SEARCH_MAX_TOP_K=100
SEARCH_MAX_QUERY_CHARS=256
# 每个通道最多取多少个文件参与 RRF 融合
SEARCH_CHANNEL_DEPTH=100
# RRF 常数 k
SEARCH_RRF_K=60
# 文件名、标签的检索权重
SEARCH_META_FILENAME_WEIGHT=1.0
SEARCH_META_TAGS_WEIGHT=1.0
# 命中片段的长度（字符）
SEARCH_SNIPPET_CHARS=150
# 图像通道调用 CLIP 服务编码查询文本的超时（秒，最大 60）；超时则本次降级为纯文本检索
SEARCH_IMAGE_TIMEOUT_SECONDS=3
# 请求未指定时各通道是否开启；图像通道需要 CLIP 服务，默认关闭
SEARCH_CHANNEL_META_ENABLED=true
SEARCH_CHANNEL_TEXT_ENABLED=true
SEARCH_CHANNEL_IMAGE_ENABLED=false

# ---- 解析（可选，以下为默认值）----
# PDF 某页的有效字符数（不计空白）低于它、且页面上有图片或图形时，该页走 OCR
PDF_OCR_MIN_CHARS=20
# docx / xlsx 是 zip 压缩包：解压后的总大小（字节）和文件数超过上限就拒绝解析（防 zip 炸弹）
PARSE_ZIP_MAX_TOTAL_BYTES=209715200
PARSE_ZIP_MAX_ENTRIES=5000
# 图片像素数（宽 × 高）上限，超过就拒绝处理
PARSE_IMAGE_MAX_PIXELS=100000000

# ---- 切分（可选，以下为默认值）----
# 片段最大字符数（50–10000）与相邻片段的重叠字符数（不超过前者的一半）。改动后需要重新解析
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=50

# ---- Worker（可选，以下为默认值）----
# 租约时长（秒）：Worker 崩溃后，任务最多等这么久被重新领取
WORKER_LEASE_SECONDS=60
# 续租间隔（秒），不能超过租约时长的一半
WORKER_HEARTBEAT_SECONDS=15
# 队列为空时的轮询间隔（秒）
WORKER_POLL_SECONDS=2
# 单个任务的处理时间上限（秒）
WORKER_TASK_TIMEOUT_SECONDS=600
# 单个任务子进程的内存上限（MB）；只在 Linux 上有效
WORKER_MEMORY_LIMIT_MB=2048
# 处理多少个任务后 Worker 主动退出（由外层重新拉起）
WORKER_MAX_TASKS=50
# 连接数据库最多等多久（秒，整数 2–300）：主机不可达时启动检查在这个时间内报错
WORKER_DB_CONNECT_TIMEOUT_SECONDS=10
# 失败任务的重试间隔（秒，逗号分隔），通用 Worker 与 OCR Worker 共用：第 1 次尝试失败后，距那次
# 尝试开始至少 30 秒才再试；第 2 次失败后 120 秒。写 0 表示马上重试
TASK_RETRY_DELAYS_SECONDS=30,120

# ---- 仅测试用 ----
# 集成测试用的专用空数据库（不设置则跳过这些测试）。必须与 DATABASE_URL 是不同的库：
# 测试结束会清空它。
# TEST_DATABASE_URL=postgresql://docmgr:change-me@localhost:5432/docmgr_test

# ---- CLIP 模型服务（services/clip_service，clip 环境；全部可选，以下为默认值）----
# 权重文件。相对路径相对项目根目录；文件不存在时服务启动即报错退出，不会联网下载
CLIP_MODEL_PATH=models/clip/clip_cn_vit-b-16.pt
# cn_clip 的模型结构名，必须与权重文件对应
CLIP_MODEL_NAME=ViT-B-16
# 权重文件的 sha256（64 位十六进制）。填了就在启动时核对，不一致则不启动；留空只记录不核对
CLIP_MODEL_SHA256=
# 运行设备：cpu、mps（Apple 芯片）、cuda。默认 cpu，不同机器上结果可复现
CLIP_DEVICE=cpu
# 监听地址和端口。接口没有鉴权，只监听本机，不要改成对外地址
CLIP_HOST=127.0.0.1
CLIP_PORT=8001
# 一张图片的字节数上限（默认与 UPLOAD_MAX_BYTES 相同）和像素数上限（宽 × 高）
CLIP_MAX_IMAGE_BYTES=52428800
CLIP_MAX_IMAGE_PIXELS=100000000
# 一次请求最多编码多少条文本；单条文本的字符数上限（模型只用前 52 个 token）
CLIP_MAX_TEXTS=32
CLIP_MAX_TEXT_CHARS=1000
